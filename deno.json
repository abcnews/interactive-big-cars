{
	"tasks": {
		"dev": "deno run -A --node-modules-dir npm:vite",
		"build": "deno run -A --node-modules-dir npm:vite build",
		"preview": "deno run -A --node-modules-dir npm:vite preview",
		"serve": "deno run --allow-net --allow-read jsr:@std/http@1/file-server dist/"
	},
	"compilerOptions": {
		"lib": ["ES2023", "DOM"]
	},
	"imports": {
		"@abcnews/env-utils": "npm:@abcnews/env-utils@^6.1.0",
		"@abcnews/mount-utils": "npm:@abcnews/mount-utils@^3.0.1",
		"@abcnews/svelte-scrollyteller": "npm:@abcnews/svelte-scrollyteller@^4.0.1",
		"@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
		"@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.0.0",
		"sass-embedded": "npm:sass-embedded@^1.103.1",
		"svelte": "npm:svelte@^5.55.1",
		"vite": "npm:vite@^8.0.3"
	}
}
